{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LoanDb": "Data Source=loanapp.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "PublicApiBaseUrl": "http://localhost:5088",
  "Storage": {
    "Mode": "Local",
    "LocalRoot": "blobs",
    "Container": "loan-documents"
  },
  "ServiceBus": {
    "Mode": "InMemory",
    "Queue": "loan-applications"
  },
  "BankCore": {
    "BaseUrl": "http://localhost:5090/",
    "ApiKey": "dev-bank-key"
  },
  "Auth": {
    "UseDevelopmentAuth": true,
    "Authority": "https://YOUR_TENANT.b2clogin.com/YOUR_TENANT.onmicrosoft.com/B2C_1_signupsignin/v2.0",
    "Audience": "api://loan-app"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "FeatureFlags": {
    "AiAssistant": false,
    "AiVerificationAssist": false
  }
}
